# nvrWay server configuration — copy to .env and fill in.
# Every variable below is read by server/config; defaults are what the server
# runs with when the variable is absent. docs/configuration.md is the same
# table. Under compose the server container receives this whole file through
# env_file, so anything set here arrives — the exceptions are the few
# variables the compose environment block owns and therefore overrides
# (marked below), and POSTGRES_PASSWORD, which the compose file itself
# consumes.

# --- listen / database ---------------------------------------------------------
# Compose-managed: under both stacks the environment block sets SERVER_PORT,
# DATA_DIR and DATABASE_URL for the container, and environment wins over
# env_file — what you set here for those three is ignored in containers.
SERVER_PORT=":8080"
# gorm DSN. postgresql://... uses Postgres; sqlite://path (or ":memory:") uses
# sqlite — the test and scripts/dev.sh path. Under compose the container's
# DSN is composed from POSTGRES_PASSWORD; set that, not this, in containers.
DATABASE_URL="postgresql://nvr:nvr@localhost:5432/nvr?sslmode=disable"
# Postgres password. Required by the prod compose — it refuses to resolve
# without it — which sets it for the database container and builds the
# server's container DSN from it. Not read by server/config itself.
POSTGRES_PASSWORD=""

# --- signing -------------------------------------------------------------------
# HS256 key. Empty means a fresh random key per boot: sessions do not survive a
# restart. Generate one: openssl rand -hex 32
JWT_SECRET=""
# AES-256-GCM key sealing storage-backend credentials, as 64 hex chars. Required
# in production; unset it falls back to SHA-256(JWT_SECRET), so a deployment has
# exactly one secret to back up. openssl rand -hex 32
NVR_SECRET_KEY=""

# --- media tree ----------------------------------------------------------------
DATA_DIR="/var/lib/nvr"
# Derived from DATA_DIR when unset: $DATA_DIR/segments, /clips, /snapshots
SEGMENTS_DIR=""
CLIPS_DIR=""
SNAPSHOTS_DIR=""

# --- go2rtc --------------------------------------------------------------------
GO2RTC_URL="http://go2rtc:1984"
# go2rtc API credentials — OPTIONAL, unset by default (P-14): the sidecar is
# a trusted-LAN service, and its open API is what makes browser live view
# work (a browser cannot attach basic auth to a WebSocket). Set both only to
# put the sidecar behind a reverse proxy that carries the auth —
# docs/installation.md § 11 has the recipe, docs/configuration.md § P-14 the
# full trade. When set, the sidecar boots authenticated from first boot.
GO2RTC_USERNAME=""
GO2RTC_PASSWORD=""
GO2RTC_RTSP_URL="rtsp://go2rtc:8554"
# Browser-facing base for live view: the console must be able to reach this.
GO2RTC_PUBLIC_URL="http://localhost:1984"
# Detection tap transcoding (the <slug>_det mjpeg stream)
GO2RTC_MJPEG_WIDTH="640"
GO2RTC_MJPEG_HEIGHT="360"
GO2RTC_MJPEG_FPS="5"
# Sidecar recreation by the server after a camera write (S3-07). Unset, the
# server cannot restart the sidecar itself: the dev compose ships a config
# supervisor instead, and a prod operator either restarts go2rtc after camera
# changes or wires these four — they make the server run
# `docker compose ... restart <service>`, which needs the docker socket
# mounted into the server container. The prod compose does not mount it:
# socket access is root-equivalent, so it stays an explicit operator choice.
#GO2RTC_COMPOSE_FILE=docker-compose.prod.yml
#GO2RTC_COMPOSE_DIR=/opt/nvr
#GO2RTC_COMPOSE_SERVICE=go2rtc
#GO2RTC_COMPOSE_BIN=docker

# --- detection worker ----------------------------------------------------------
# Bearer for /api/internal/* (openssl rand -hex 32). Empty disables the
# internal API entirely.
WORKER_TOKEN=""
# Comma-separated ONNX runtime providers. CPU is the verified default;
# CUDAExecutionProvider needs the NVIDIA container toolkit on the host.
DET_PROVIDERS="CPUExecutionProvider"

# --- break-glass local admin ---------------------------------------------------
BOOTSTRAP_ADMIN_USER="admin"
# Set this BEFORE first boot: empty = no local admin account is created, and
# an installation with neither this password nor working OIDC has no way in
# (docs/installation.md § 5).
BOOTSTRAP_ADMIN_PASSWORD=""

# --- OIDC (seeds the provider row oidc on first boot) --------------------------
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_ROLE_CLAIM="groups"
# group=role,group=role — empty means no mapping and the viewer floor stands.
OIDC_ROLE_MAPPING=""

# --- recording / events --------------------------------------------------------
SEGMENT_SECONDS="5"
PRE_ROLL_SECONDS="8"
POST_ROLL_SECONDS="15"
EVENT_MAX_SECONDS="300"

# --- retention (days; 0 remote means keep remote forever) ----------------------
LOCAL_RETENTION_DAYS="14"
REMOTE_RETENTION_DAYS="30"
EVENT_RETENTION_DAYS="90"
UPLOADER_TICK_SECONDS="30"

# --- API budget / origins ------------------------------------------------------
RATE_LIMIT_PER_MINUTE="120"
# 0 = one tenth of the budget
RATE_LIMIT_BURST="0"
# Comma-separated allowed WebSocket origins; empty falls back to WEB_URL.
WS_ORIGINS=""
WEB_URL="http://localhost:3000"
# The origin a *webhook receiver* dials. Builds the payload's snapshot_url and
# clip_url; empty means http://localhost:8080, which only works when the receiver
# runs on this host. Use the LAN address or the reverse-proxy origin, and keep a
# proxy's path prefix (https://cam.example.com/nvr is preserved).
PUBLIC_BASE_URL=""

TZ="UTC"
