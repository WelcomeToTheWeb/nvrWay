# nvrWay server configuration — copy to .env and fill in.
# Every variable below is read by server/config; defaults are what the server
# runs with when the variable is absent. docs/configuration.md is the same table.

# --- listen / database ---------------------------------------------------------
SERVER_PORT=":8080"
# gorm DSN. postgresql://... uses Postgres; sqlite://path (or ":memory:") uses
# sqlite — the test and scripts/dev.sh path.
DATABASE_URL="postgresql://nvr:nvr@localhost:5432/nvr?sslmode=disable"

# --- signing -------------------------------------------------------------------
# HS256 key. Empty means a fresh random key per boot: sessions do not survive a
# restart. Generate one: openssl rand -hex 32
JWT_SECRET=""
# AES-256-GCM key sealing storage-backend credentials, as 64 hex chars. Required
# in production; unset it falls back to SHA-256(JWT_SECRET), so a deployment has
# exactly one secret to back up. openssl rand -hex 32
NVR_SECRET_KEY=""

# --- media tree ----------------------------------------------------------------
DATA_DIR="/var/lib/nvr"
# Derived from DATA_DIR when unset: $DATA_DIR/segments, /clips, /snapshots
SEGMENTS_DIR=""
CLIPS_DIR=""
SNAPSHOTS_DIR=""

# --- go2rtc --------------------------------------------------------------------
GO2RTC_URL="http://go2rtc:1984"
GO2RTC_USERNAME=""
GO2RTC_PASSWORD=""
GO2RTC_RTSP_URL="rtsp://go2rtc:8554"
# Browser-facing base for live view: the console must be able to reach this.
GO2RTC_PUBLIC_URL="http://localhost:1984"
# Detection tap transcoding (the <slug>_det mjpeg stream)
GO2RTC_MJPEG_WIDTH="640"
GO2RTC_MJPEG_HEIGHT="360"
GO2RTC_MJPEG_FPS="5"

# --- detection worker ----------------------------------------------------------
# Bearer for /api/internal/* (openssl rand -hex 32). Empty disables the
# internal API entirely.
WORKER_TOKEN=""
# Comma-separated ONNX runtime providers. CPU is the verified default;
# CUDAExecutionProvider needs the NVIDIA container toolkit on the host.
DET_PROVIDERS="CPUExecutionProvider"

# --- break-glass local admin ---------------------------------------------------
BOOTSTRAP_ADMIN_USER="admin"
# Empty password = no local admin account is created.
BOOTSTRAP_ADMIN_PASSWORD=""

# --- OIDC (seeds the provider row oidc on first boot) --------------------------
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_ROLE_CLAIM="groups"
# group=role,group=role — empty means no mapping and the viewer floor stands.
OIDC_ROLE_MAPPING=""

# --- recording / events --------------------------------------------------------
SEGMENT_SECONDS="5"
PRE_ROLL_SECONDS="8"
POST_ROLL_SECONDS="15"
EVENT_MAX_SECONDS="300"

# --- retention (days; 0 remote means keep remote forever) ----------------------
LOCAL_RETENTION_DAYS="14"
REMOTE_RETENTION_DAYS="30"
EVENT_RETENTION_DAYS="90"
UPLOADER_TICK_SECONDS="30"

# --- API budget / origins ------------------------------------------------------
RATE_LIMIT_PER_MINUTE="120"
# 0 = one tenth of the budget
RATE_LIMIT_BURST="0"
# Comma-separated allowed WebSocket origins; empty falls back to WEB_URL.
WS_ORIGINS=""
WEB_URL="http://localhost:3000"
# The origin a *webhook receiver* dials. Builds the payload's snapshot_url and
# clip_url; empty means http://localhost:8080, which only works when the receiver
# runs on this host. Use the LAN address or the reverse-proxy origin, and keep a
# proxy's path prefix (https://cam.example.com/nvr is preserved).
PUBLIC_BASE_URL=""

TZ="UTC"
