# =============================================================================
# nvrWay Detection worker — multi-stage Docker build (skeleton, card S0-03)
# =============================================================================
# Content is card S9-02; the model provenance story is S5-12.
#
# The host's Python cannot host this worker (no pip/venv on the host Python),
# so every Python task — including the test suites — runs inside this image.
#
# Build:  docker build -f docker/Dockerfile.detector -t nvr/detector .
# Run:    the `detector` service in docker/docker-compose.yml
# =============================================================================

# --- Stage 1: export the model --------------------------------------------------
# yolov8n.pt is fetched from the pinned URL of Step 5 and exported to ONNX at
# build time; the weights are never committed to the repo (README's License
# section, attribution in testdata/fixtures.json — S5-12).
FROM python:3.12-slim AS export

RUN pip install --no-cache-dir ultralytics==8.4.195 onnx==1.17.0

# ultralytics imports cv2 at package import (`ultralytics/utils/__init__.py:26`),
# and the `opencv-python` wheel it depends on is the GUI build: on a slim image it
# dies with `ImportError: libxcb.so.1: cannot open shared object file` before the
# export runs. These are the X/GL runtime libs that wheel links against. They live
# in this discarded stage only — the runtime image keeps the plan's
# `opencv-python-headless` and needs none of them. Deliberately placed after the
# pip layer so a fix here does not invalidate the torch download.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 libxcb1 libx11-6 libxext6 libsm6 \
    && rm -rf /var/lib/apt/lists/*

# Pinned URL; a build with no network fails loudly here rather than shipping a
# runtime image with no model.
RUN mkdir -p /models && \
    python - <<'PY'
import urllib.request
URL = "https://github.com/ultralytics/assets/releases/download/v8.3.0/yolov8n.pt"
urllib.request.urlretrieve(URL, "/models/yolov8n.pt")
PY

RUN python -c "from ultralytics import YOLO; YOLO('/models/yolov8n.pt').export(format='onnx', imgsz=640, opset=17, dynamic=False)"

# --- Stage 2: runtime -----------------------------------------------------------
# CPU ONNX is the verified baseline: CUDAExecutionProvider needs the NVIDIA
# container toolkit on the host and is an overlay (docker-compose.gpu.yml,
# S9-06), not the default of this image.
# Named so `--target runtime` can rebuild it alone: stage 1 imports nothing
# from the build context, so a detector/ change re-runs only stage 2's COPY
# and editable install — the torch download and the ONNX export stay cached
# and need no network for that rebuild. (A literal `--network=none` build
# re-runs every pip layer — BuildKit keys RUN cache on the network mode — and
# then fails loudly at stage 1's first pip install, which is the other half
# of the card's criterion.)
FROM python:3.12-slim AS runtime

RUN pip install --no-cache-dir \
        onnxruntime==1.31.1 \
        opencv-python-headless==5.0.0.93 \
        numpy \
        requests \
        pydantic \
        pytest \
        onnx==1.17.0
# `onnx` is the suite's, not the worker's: the tests synthesise tiny ONNX models
# (conftest.write_tiny_onnx) with the same serialiser the export stage uses, and
# this image is the only environment that can run the suite — the host Python
# has no pip (the card's own note). It is pinned to the export stage's version
# so fixture and shipped model come from one serialiser. pytest is here for the
# same reason (S9-02).

RUN groupadd -r nvr && useradd -r -g nvr nvr

WORKDIR /app
COPY detector/ ./
RUN pip install --no-cache-dir -e .

# The exported model, and a writable home for the heartbeat/config cache the
# worker keeps.
COPY --from=export /models/yolov8n.onnx /models/yolov8n.onnx
RUN chown -R nvr:nvr /models /app

USER nvr:nvr

ENV DET_PROVIDERS=CPUExecutionProvider
ENV NVR_SERVER_URL=http://server:8080
# The name the worker actually reads (`DET_MODEL_PATH` in `__main__`). The
# skeleton had `NVR_MODEL_PATH`, which nothing parses: the worker would have
# fallen back to its own default and the image's env would have been decoration.
ENV DET_MODEL_PATH=/models/yolov8n.onnx
ENV GO2RTC_URL=http://go2rtc:1984
ENV TZ=UTC

# Liveness is data, not a listener: the worker POSTs
# /api/internal/v1/heartbeat every 30 s and /api/healthz reports fresh/stale
# (S9-07). The container healthcheck is therefore the process check.
CMD ["python", "-m", "nvr_detector"]

# --- Stage 3: GPU runtime (S9-06) ----------------------------------------------
# The CUDA variant of the runtime image: same worker, same model, same entry
# point — only the ONNX Runtime build differs. `onnxruntime` (CPU) is replaced
# by `onnxruntime-gpu` (the CUDA 13 build of the plan's pin; the host driver
# line is 615.78.08 = CUDA 13.x, and a CUDA 12 wheel fails here with
# `CUDA failure 999` — the trap gpu-probe.sh documents), plus the cuDNN 9 the
# wheel does not pull as a dependency. The CUDA libraries themselves come
# from the wheels' own nvidia-* dependencies, installed into site-packages;
# ld.so is pointed at them at build time so the runtime needs no
# LD_LIBRARY_PATH and the unprivileged `nvr` user sees them too.
#
# Selected by docker-compose.gpu.yml (`build.target: runtime-gpu`). Because
# this is the final stage, every consumer must name its target explicitly —
# the base compose pins `target: runtime` for exactly this reason; a default
# build here would silently turn the CPU baseline into a 2 GB CUDA image.
FROM runtime AS runtime-gpu

# The runtime stage ends as the unprivileged `nvr` user; pip needs root here
# (site-packages and /usr/local/bin are root-owned — as nvr, the uninstall
# dies on `/usr/local/bin/onnxruntime_test` and the install on site-packages).
# The stage hands the non-root user back before it ends, so the shipped
# container is unchanged in that respect.
USER root

# The `nvidia-*` wheels beyond the declared dependencies are not decoration:
# `ldd libonnxruntime_providers_cuda.so` names them — libcudart, libcufft,
# libcurand, libcusolver, libcusparse — and the CUDA EP dlopens them at
# provider-creation time (`libcurand.so.10: cannot open shared object file`
# is the exact failure without them), so the session silently degrades to
# CPU — the failure mode this stage exists to prevent. Unsuffixed names on
# purpose: CUDA 13 consolidated the wheels (`nvidia-curand`, not
# `nvidia-curand-cu13` — the suffixed names are 0.0.1 placeholders on PyPI).
# The one remaining `not found` in that ldd is libcuda.so.1 — the *driver*
# library, injected by the NVIDIA container toolkit at container start; it
# must never be pip-installed.
RUN pip uninstall -y --no-cache-dir onnxruntime \
    && pip install --no-cache-dir onnxruntime-gpu==1.31.1 nvidia-cudnn-cu13 \
        nvidia-cuda-runtime nvidia-cufft nvidia-curand nvidia-cusolver nvidia-cusparse

# Register every pip-shipped nvidia library dir with the dynamic linker.
# Done as a build step (not ENV) so it survives any entrypoint and any user.
RUN python3 -c "import glob, site; open('/etc/ld.so.conf.d/nvr-nvidia.conf','w').write('\n'.join(glob.glob(site.getsitepackages()[0] + '/nvidia/*/lib')) + '\n')" \
    && ldconfig

USER nvr:nvr

# The image default asks for CUDA first; CPU stays in the list so a worker
# that cannot open CUDA falls back instead of dying (the same rule the
# overlay's env states).
ENV DET_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
