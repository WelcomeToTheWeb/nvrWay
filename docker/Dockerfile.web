# =============================================================================
# nvrWay Console — multi-stage Docker build (skeleton, card S0-03)
# =============================================================================
# Shape is OurWay's docker/Dockerfile.web (MIT); content is card S9-03.
#
# Build:  docker build -f docker/Dockerfile.web -t nvr/web .
# Run:    the `web` service in docker/docker-compose.yml (3000 -> 8080 in-image)
# =============================================================================

# --- Stage 1: build the SPA ------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./

# The version the console reports; CI passes the release stamp.
ARG VERSION=dev
ENV VITE_APP_VERSION=$VERSION

RUN npm run build

# --- Stage 2: serve with nginx ---------------------------------------------------
# nginx proxies /api and /ws to server:8080 (docker/nginx.conf) and serves the
# SPA. It listens on 8080 because the unprivileged nginx user cannot bind 80;
# compose publishes 3000:8080 (settled by S9-03, wired by S9-04).
FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx \
    && chown -R nginx:nginx /run

USER nginx:nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD wget -q --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
